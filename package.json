{
  "name": "@kodamera/sanity-plugin-lucide-icon-picker",
  "version": "2.0.0",
  "description": "Lucide icon picker for Sanity Studio 6.10+ (@sanity/ui v4). Maintained fork of contentwrap/sanity-plugin-lucide-icon-picker.",
  "keywords": [
    "sanity",
    "sanity-plugin",
    "lucide",
    "icons",
    "sanity-studio",
    "lucide-icons",
    "sanity-lucide",
    "sanity-icons"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kodamera/sanity-plugin-lucide-icon-picker.git"
  },
  "homepage": "https://github.com/kodamera/sanity-plugin-lucide-icon-picker#readme",
  "bugs": {
    "url": "https://github.com/kodamera/sanity-plugin-lucide-icon-picker/issues"
  },
  "license": "MIT",
  "author": "ContentWrap <tamba@contentwrap.io>",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check --clean",
    "dev": "pnpm --dir dev dev",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@sanity/icons": "^5.0.0",
    "@sanity/ui": "^4.0.0",
    "@tanstack/react-virtual": "^3.14.13",
    "lucide-react": "^1.47.0"
  },
  "devDependencies": {
    "@sanity/browserslist-config": "^1.0.5",
    "@sanity/pkg-utils": "^13.0.0",
    "@sanity/plugin-kit": "^10.0.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.0",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanity": "^6.15.0",
    "styled-components": "^6.5.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "sanity": "^6.10.0"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=20.19 <22 || >=22.12"
  },
  "packageManager": "pnpm@9.15.1+sha512.1acb565e6193efbebda772702950469150cf12bcc764262e7587e71d19dc98a423dff9536e57ea44c49bdf790ff694e83c27be5faa23d67e0c033b583be4bfcf",
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "sanityPlugin": {
    "verifyPackage": {
      "tsconfig": false
    }
  },
  "contributors": [
    "Kodamera AB (fork maintenance) <hej@kodamera.se>"
  ]
}
